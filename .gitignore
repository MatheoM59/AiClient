# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Secrets and local config (NEVER commit an API key)
# Commit only the example file: src/environments/environment.example.ts
/src/environments/environment.ts
/src/environments/environment.development.ts
.env
.env.*
!.env.example
*.local

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Angular
/.angular

# Tests
/coverage
/test-results
/playwright-report
/blob-report
__screenshots__/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Claude Code (personal settings)
.claude/settings.local.json

# Miscellaneous
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db
